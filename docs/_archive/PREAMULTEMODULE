FIX 2 — Rescrie extractModulesFromMarkdown

ȘTERS (funcția existentă completă):
function extractModulesFromMarkdown(markdown: string): string[] {
  const modules: string[] = [];
  const lines = markdown.split('\n');
  let insideTable = false;
  
  for (const line of lines) {
    if (line.trim().startsWith('|') && line.split('|').length > 3) {
      if (line.includes('---')) {
        insideTable = true;
        continue;
      }
      if (insideTable) {
         const parts = line.split('|').map(s => s.trim());
         if (parts.length > 2) {
           const topic = parts[2];
           const lower = topic.toLowerCase();
           const ignoreTerms = ['topic', 'subiect', 'tema', 'subject', 'sujet', 'themen', 'asunto'];
           if (topic && !ignoreTerms.some(t => lower.includes(t)) && topic.length > 2) {
                const cleanTopic = topic.replace(/\*\*/g, '').replace(/\*/g, '').trim();
                modules.push(cleanTopic);
           }
         }
      }
    } else {
      if (insideTable && line.trim() === '') {
        insideTable = false;
      }
    }
  }
  return modules;
}

ÎNLOCUIT CU:
function extractModulesFromMarkdown(markdown: string): string[] {
  // Extract ONLY from the dedicated MODULE_LIST_BEGIN/END section.
  // Never parse the agenda table — it contains breaks, intros, outros
  // which are not educational modules.
  const modules: string[] = [];
  
  const sectionMatch = markdown.match(
    /###\s*MODULE_LIST_BEGIN\s*\n([\s\S]*?)\n\s*###\s*MODULE_LIST_END/
  );
  
  if (!sectionMatch) {
    Logger.warn('[extractModulesFromMarkdown] MODULE_LIST section not found in markdown. No modules extracted.');
    return modules;
  }
  
  const listSection = sectionMatch[1];
  const lines = listSection.split('\n');
  
  for (const line of lines) {
    // Match numbered list items: "1. Title" or "1) Title"
    const match = line.match(/^\s*\d+[\.\)]\s+(.+)$/);
    if (match) {
      const title = match[1]
        .replace(/\*\*/g, '')
        .replace(/\*/g, '')
        .trim();
      if (title.length > 2) {
        modules.push(title);
      }
    }
  }
  
  Logger.info(`[extractModulesFromMarkdown] Extracted ${modules.length} modules from MODULE_LIST section.`);
  return modules;
}

